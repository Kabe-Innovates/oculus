# Database configuration (defaults to SQLite + aiosqlite for zero-friction setup)
DATABASE_URL=sqlite+aiosqlite:///./sentinelpay.db

# AWS SNS Integration for High-Risk (BLOCK) Alerts
# Leave empty to use standard console alert logger fallback
SNS_TOPIC_ARN=
AWS_REGION=ap-south-1

# Detection Rule Thresholds
VELOCITY_WINDOW_SECONDS=300
VELOCITY_THRESHOLD=5
AMOUNT_DEVIATION_THRESHOLD=2.0
GEO_MAX_SPEED_KMH=900.0

# Risk Thresholds
RISK_BLOCK_THRESHOLD=75.0
RISK_REVIEW_THRESHOLD=40.0

# Ingestion Simulator
SIMULATOR_RATE=2.0
